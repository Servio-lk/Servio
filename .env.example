# ======================================================
# Servio — Root Environment Variables
# ======================================================
# Copy this file to .env and fill in your actual values.
# This file is used by docker-compose.yml and docker-compose.prod.yml.
# NEVER commit the .env file to version control.
# ======================================================

# ---------- Supabase Database ----------
DB_HOST=aws-0-<your-region>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=your-supabase-db-password
DB_NAME=postgres

# ---------- Supabase Auth ----------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------- JWT (Backend) ----------
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRATION=604800000

# ---------- Port Configuration (Docker) ----------
FRONTEND_PORT=80
ADMIN_PORT=8081
BACKEND_PORT=3001

# ---------- CORS / Frontend URLs ----------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8081,http://localhost:5173
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80,http://localhost:8081

# ---------- Vite (Frontend Build Args) ----------
# In local dev with docker-compose, use the nginx reverse proxy path:
VITE_API_URL=/api
# For S3/CloudFront deployment, set to the EC2 backend URL:
# VITE_API_URL=http://<your-ec2-ip>:3001/api

# ---------- PayHere Payment Gateway ----------
PAYHERE_MERCHANT_ID=1219999
PAYHERE_MERCHANT_SECRET=your-merchant-secret-here
PAYHERE_SANDBOX=true

# ---------- Container Image (Production / GHCR) ----------
# BACKEND_IMAGE=ghcr.io/<your-github-username-or-org>/servio-backend:latest

# ---------- Mobile Backend API URL (EC2 or Local) ----------
SERVIO_API_BASE_URL=http://<your-ec2-ip>:3001/api
