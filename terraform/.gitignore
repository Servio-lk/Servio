# Local .terraform directories
**/.terraform/*

# .tfstate files (contain raw state, unencrypted sensitive values & secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive .tfvars files
*.tfvars
*.tfvars.json

# Preserve example configuration template
!terraform.tfvars.example

# Ignore override files as they are meant for local customization
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
